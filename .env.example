# For EmailJS - get from your EmailJS account dashboard
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# Template ID for the "Contact Us" form on the marketing page
NEXT_PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID=your_contact_template_id

# Template ID for the subscription receipt email
NEXT_PUBLIC_EMAILJS_RECEIPT_TEMPLATE_ID=your_receipt_template_id

# Template ID for the "Invite User" email
NEXT_PUBLIC_EMAILJS_INVITE_TEMPLATE_ID=your_invite_template_id

# For Paystack - get from your Paystack dashboard
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx

# For ImgBB - get from imgbb.com
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key

# Resend Email Configuration
RESEND_API_KEY=
RESEND_FROM_EMAIL=Zeneva <success@zeneva.space>

# Firebase Frontend
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Web Push certificate public key. Firebase console > Project Settings >
# Cloud Messaging > Web Push certificates > Generate key pair.
# Public by design — it ships in the client bundle, which is why it is
# NEXT_PUBLIC_. Without it use-fcm.ts refuses to mint a token and no device
# can ever be pushed to, so a missing value here silently disables the whole
# notification system rather than failing loudly.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# AI Provider Configuration
# Set AI_PROVIDER to 'groq' (default) or 'gemini'
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
